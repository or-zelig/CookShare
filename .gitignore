# dependencies
**/node_modules/

# build outputs
**/dist/
**/build/

# user uploads
**/uploads/

# env files (never commit secrets)
**/.env
**/.env.*
**/.envprod
!**/.env.example
!**/.env.production
!**/.envprod.example

# certificates / private keys
**/*.pem
**/*.key
**/*.crt
**/*.csr
**/*.pfx
**/*.p12

# logs
**/*.log
logs/

# editor/os
.vscode/
.idea/
.DS_Store
Thumbs.db

# vite / tooling caches
**/.vite/
**/.cache/

# coverage
**/coverage/

# typescript
**/*.tsbuildinfo
